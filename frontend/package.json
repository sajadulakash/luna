{
  "name": "luna-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "certs": "openssl req -x509 -nodes -newkey rsa:2048 -keyout certs/dev-key.pem -out certs/dev-cert.pem -days 825 -subj \"/CN=luna-dev\" -addext \"subjectAltName=DNS:localhost,IP:127.0.0.1,IP:$LUNA_LAN_IP\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.0",
    "lucide-react": "^1.33.0",
    "luxon": "^3.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
